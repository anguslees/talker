# Export these variables in the shell that runs Talker. This file is not auto-loaded.
# Gemini Developer API. The browser receives only a constrained ephemeral token.
GEMINI_API_KEY=
# Alternative: GEMINI_API_KEY_FILE=/path/to/private/key
TALKER_MODEL=gemini-3.8-live
TALKER_VOICE=Aoede
TALKER_TEMPERATURE=1.1
TALKER_LISTEN=127.0.0.1:8080
TALKER_STATE=data/tasks.json
TALKER_QUIET_PERIOD=2s

# Hermes API Server adapter, not the dashboard. A forwarded HTTP URL is supported.
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Optional bearer token for POST /api/events from other background integrations.
TALKER_EVENT_TOKEN=
